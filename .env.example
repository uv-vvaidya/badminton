# Railway sets PORT automatically.
# Reference your Railway Postgres service: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/badminton
# Required to create the first admin account at /#admin. Use a long random value.
SETUP_TOKEN=change-me-to-a-long-random-string
# Default tournament name before setup (changeable any time in Admin → Settings).
TOURNAMENT_NAME=UV Badminton Open
# Only if you connect through a public (TLS) database URL instead of Railway's private network.
# PGSSL=true
